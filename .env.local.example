# Базовий URL бекенду разом із префіксом /api.
# Локально бекенд (cosmogram-back) слухає 3000, тому для нього піднімайте
# інший порт або запускайте фронт через `next dev -p 3001` — інакше конфлікт.
# Продакшн: https://cosmogram-back.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Адреса самого фронту. Потрібна для metadataBase: з неї Next робить
# абсолютні URL для OG-тегів і canonical. Без неї прев'ю при шерингу
# збирається неправильно. У проді — реальний домен сайту.
NEXT_PUBLIC_SITE_URL=http://localhost:3000